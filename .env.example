# The app's runtime keys — Supabase project → Project Settings → API.
# Copy this file to .env.local and fill both in. Without them the app still
# runs: it opens on the sign-in page with "Have a look around" for a guest tab.
#
# These are for the browser app only. Applying migrations does NOT read this
# file: `supabase link` and `supabase db push` authenticate through the CLI's
# own login and your database password. Never put a service-role or sb_secret_
# key here — anything named VITE_* is compiled into the public bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
